{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/wiki/:slug",
      "destination": "https://rooted-backend-production.up.railway.app/wiki/:slug"
    },
    {
      "source": "/s/:id",
      "destination": "https://rooted-backend-production.up.railway.app/s/:id"
    },
    {
      "source": "/plants",
      "destination": "https://rooted-backend-production.up.railway.app/plants"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://rooted-backend-production.up.railway.app/sitemap.xml"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://rooted-backend-production.up.railway.app/admin/:path*"
    }
  ]
}
